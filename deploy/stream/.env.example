# Zkopírujte na .env a upravte. Výchozí hodnoty jsou pro ostré vysílání s hlasem Piper.
MODE=stream
AUTOSTART=0
TTS_ENGINE=piper
V_BITRATE=4500k
# Kdybyste chtěli kvalitnější hlas z Azure:
# TTS_ENGINE=azure
# AZURE_SPEECH_KEY=...
# AZURE_SPEECH_REGION=westeurope
# AZURE_VOICE=cs-CZ-VlastaNeural
# Kdyby server (2 vCPU) nestíhal a ./stream.sh status ukazoval speed pod 1.0x, odkomentujte a udělejte ./stream.sh down && ./stream.sh up:
# X264_PRESET=superfast
# FPS=25
# V_BITRATE=3000k
# Tempo hlasu Piper (méně = rychleji, výchozí 0.8)
# PIPER_LENGTH_SCALE=0.8
